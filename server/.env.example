# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Public HTTPS host this server is reachable at, with no scheme and no trailing
# slash. Twilio dials a wss:// URL derived from this, so it must be publicly
# resolvable. For local development run `ngrok http 8080` and paste the domain.
PUBLIC_HOST=your-subdomain.ngrok-free.app

PORT=8080

# Shared secret the Android app sends as the `x-api-token` header. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_API_TOKEN=

# --- Runware (the language model) ------------------------------------------
# Runware serves an OpenAI-compatible chat endpoint in front of models from
# several vendors, so this one key covers all of them.
RUNWARE_API_KEY=
RUNWARE_BASE_URL=https://api.runware.ai/v1

# Measured first-token latency on this account, which is what the person on the
# line waits through before hearing anything:
#   anthropic-claude-haiku-4-5   ~1.6s   default: fastest that also handles tools well
#   google-gemini-3-flash        ~1.9s   fast, but streamed in very few chunks in testing
#   anthropic-claude-sonnet-4-6  ~3.0s   better judgement, noticeably longer pauses
# Heavier options if you care more about judgement than speed:
#   anthropic-claude-opus-4-8, anthropic-claude-fable-5, openai-gpt-5-5
# Run `npm run models` to list everything your key can reach.
LLM_MODEL=anthropic-claude-haiku-4-5

# A runaway guard, not a target — spoken replies are one or two sentences.
LLM_MAX_TOKENS=1000

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
# Either fill in the Auth Token from the Console dashboard...
TWILIO_AUTH_TOKEN=
# ...or create an API Key (Console > Account > API keys & tokens) and use that
# instead. An API Key can be revoked and reissued on its own, and is the way in
# if the Auth Token has been rotated. When both are set, the API Key wins.
# Note: Twilio signs status webhooks with the Auth Token, so with an API Key
# alone the server skips those callbacks rather than exposing an endpoint it
# cannot verify. Calls still work — the relay socket reports progress.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Twilio credentials are only valid in the Region they were created in. Leave
# blank for the default US1. Set to ie1 or au1 to match the Region selector in
# your Console, optionally with an edge (dublin, frankfurt, sydney, ashburn).
TWILIO_REGION=
TWILIO_EDGE=
# A Twilio number you own, in E.164 format. This is the number that shows up on
# the recipient's caller ID.
TWILIO_FROM_NUMBER=+441234567890

# --- You -------------------------------------------------------------------
# Your name. The agent introduces itself as calling on your behalf using this.
OWNER_NAME=
# Your real phone number in E.164. Used for warm transfer: when the agent hits
# something it must not handle alone (identity verification, a decision that is
# yours to make) it dials you and bridges you into the live call.
OWNER_PHONE=+441234567890

# --- Voice ----------------------------------------------------------------
# Twilio ConversationRelay handles speech-to-text and text-to-speech for you.
# Leave both blank to use Twilio's default voice. If you set TTS_PROVIDER
# (Google, Amazon, ElevenLabs) you must also set TTS_VOICE to an id that
# provider offers, or the call will fail as soon as it connects.
TTS_PROVIDER=
TTS_VOICE=
TTS_LANGUAGE=en-GB
TRANSCRIPTION_LANGUAGE=en-GB

# Recording is off by default and should stay off unless you have checked the
# consent rules where you and the other party are. See README.
RECORD_CALLS=false

# Hard ceiling on one call, in seconds. Protects against a hold queue nobody
# answers and against the assistant occasionally not hanging up on its own.
MAX_CALL_SECONDS=600

# --- Sign-in ---------------------------------------------------------------
# Google sign-in. Paste the *Web application* OAuth client id from Google Cloud
# Console here (it ends in .apps.googleusercontent.com). The Android app reads
# it back from /api/auth/methods, so this is the only place it is configured.
# You also need an *Android* OAuth client in the same project, registered with
# the app's package name and signing certificate SHA-1 — that one is not pasted
# anywhere, it just has to exist for Google to issue the token.
# Leave blank and the app hides the Google button rather than showing one that
# cannot work. Email and password always work regardless.
GOOGLE_CLIENT_ID=

# The same thing for iOS, and it has to be its own line: Google issues the ID
# token to whichever client asked for it, so a token from the iOS app carries the
# iOS client id in its `aud` and the server checks both. Create an *iOS* OAuth
# client in the same Cloud project with bundle id com.voicecall.mynah and paste
# it here. Unlike the Android one this value is used by the app — it is what the
# sign-in sheet is opened with — so it is served from /api/auth/methods too.
# Blank hides the Google button on iOS and leaves Android untouched.
GOOGLE_IOS_CLIENT_ID=

# SMS sign-in codes, via a Twilio Verify service. Left unset on purpose: this
# deployment signs in with Google and email only.
TWILIO_VERIFY_SERVICE_SID=

# Resetting a forgotten password sends a six-digit code by email — the only
# email this server ever sends. MAIL_FROM must be an address the provider has
# verified for your domain. The default URL is Resend's; any provider with a
# JSON send endpoint works by changing it and the one function in src/mail.js.
# Left blank, the app hides "forgot password" and the code goes to the server
# log instead, so a self-hosted deployment can still get itself back in.
MAIL_API_KEY=
MAIL_API_URL=https://api.resend.com/emails
MAIL_FROM=

# Caller ID verification: letting a user's calls go out under their own number
# instead of TWILIO_FROM_NUMBER. Twilio rings them from the number below and
# they key a six-digit code in; the app shows both before the phone rings, and
# CALLER_ID_VERIFY_DELAY is the head start it gets to do that. Change the first
# only if Twilio changes the number it verifies from.
CALLER_ID_VERIFY_FROM=+14157234000
CALLER_ID_VERIFY_DELAY=12

# How long before another verification call may be placed for the same account,
# in seconds. Every one dials a real phone and is billed, and the screen puts a
# "ring me again" button next to the code. 0 turns the limit off.
CALLER_ID_VERIFY_COOLDOWN=90

# --- Billing ---------------------------------------------------------------
# Calls are paid for in credits: one credit is one call that connects, and a
# call nobody answers is refunded on the spot. See src/billing/credits.js.

# Calls a new account can place before buying anything. One-time, not monthly.
TRIAL_CALLS=3

# The in-app products the app may sell, as productId:calls pairs. The ids must
# match consumable in-app products created in the Play Console, where their
# prices are set. Blank hides the shop in the app entirely.
#   PLAY_PACKS=calls10:10,calls30:30
PLAY_PACKS=

# How purchases are verified before credits land. PLAY_PACKAGE_NAME is the
# applicationId (com.voicecall). The service-account key comes from Google
# Cloud: create a service account, grant it access under Play Console > Users
# and permissions with "View financial data", and point this at its JSON key.
# With either blank, the verify endpoint refuses rather than trusting the app.
PLAY_PACKAGE_NAME=
PLAY_SERVICE_ACCOUNT_FILE=

# --- The second way to pay: Stripe, on the web -------------------------------
# The app hands out a thirty-minute link to /pay, which takes cards, WeChat Pay
# and Alipay. It exists mostly for the last two — Play Billing cannot offer them
# on a UK account, and they are what these users have — and because the link can
# be sent to whoever is actually paying, who is often a family member abroad.
#
# Leave STRIPE_SECRET_KEY or STRIPE_PACKS blank and the app shows Play alone.
STRIPE_SECRET_KEY=
# Public, and served to the app so it can open Stripe's payment sheet without
# sending anybody to a browser. It identifies the account and can do nothing on
# its own, which is why it is served rather than built into the APK — the same
# arrangement as GOOGLE_CLIENT_ID. Blank, the app offers only the link.
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint you add in the Stripe dashboard, pointed at
# https://<PUBLIC_HOST>/stripe/webhook, subscribed to checkout.session.completed
# and checkout.session.async_payment_succeeded. Credits land on that webhook and
# nowhere else — the redirect after paying proves nothing.
STRIPE_WEBHOOK_SECRET=
# "priceId:calls" pairs, matching Price objects in the Stripe dashboard. The
# amounts live there, not here, so a price change is a dashboard edit.
#   STRIPE_PACKS=price_1AbCdEfGhIjKlMnO:10,price_1PqRsTuVwXyZ0123:30
STRIPE_PACKS=

# Note on tax: Stripe does not act as merchant of record, so VAT is yours to
# handle. Selling to UK consumers under the registration threshold, there is
# nothing to do. Selling digital services to EU consumers has no threshold at
# all — that is registrable from the first sale. Google and Paddle handle this
# for you; Stripe does not.

# --- Published documents ---------------------------------------------------
# Who operates the service, where to write, and whose law the terms are under.
# They appear in /legal/terms and /legal/privacy, which the app links to and
# which Google Play requires to be publicly reachable by anyone. Left blank
# they render as a highlighted placeholder rather than quietly shipping a hole.
#   LEGAL_ENTITY=Rui Xia
#   LEGAL_CONTACT_EMAIL=support@example.com
#   LEGAL_JURISDICTION=England and Wales
LEGAL_ENTITY=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=
