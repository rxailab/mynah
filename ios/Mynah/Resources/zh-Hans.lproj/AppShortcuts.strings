/* Siri phrases, one language per file.

   The keys are the English literals in Siri/PlaceCallIntent.swift; these are
   what someone actually says. Written here rather than in the source because
   Xcode's extractor strips non-ASCII out of a phrase literal — see the note
   on MynahShortcuts.

   ${applicationName} is substituted by the system from the bundle name, and
   Apple requires it in every phrase. */
"Make a call with ${applicationName}" = "用 ${applicationName} 打电话";
"Call someone with ${applicationName}" = "让 ${applicationName} 打个电话";
"Ask ${applicationName} to call" = "${applicationName} 帮我打电话";
