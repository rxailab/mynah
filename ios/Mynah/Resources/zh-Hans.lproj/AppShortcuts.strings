/* Siri 短语。键是 Siri/PlaceCallIntent.swift 里的英文字面量，值才是真正说出口
   的话——写在这里而不是源码里，因为 Xcode 的短语提取会把字面量里的非 ASCII
   字符剥掉。

   「打电话」和「办件事」两套都留着：前者是人真正会说的，后者是撞不上 Siri
   通话域的稳妥说法。

   两份 .strings 都填满六个槽位：系统按设备语言挑 .lproj，Siri 按自己的语言
   匹配，只存在于这里的中文短语在英文手机上够不着。 */
"Start an errand with ${applicationName}" = "用 ${applicationName} 办件事";
"New errand with ${applicationName}" = "让 ${applicationName} 跑一趟";
"Ask ${applicationName} to sort something out" = "${applicationName} 帮我办件事";
"${applicationName} errand" = "用 ${applicationName} 打电话";
"${applicationName} handle something" = "让 ${applicationName} 打个电话";
"${applicationName} do something for me" = "${applicationName} 帮我打电话";
