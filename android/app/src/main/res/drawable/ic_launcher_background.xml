<?xml version="1.0" encoding="utf-8"?>
<!--
  The pale-green wash behind the mynah: linear-gradient(150deg, #F0FBE8, #DDF3CC).
  A 150° CSS angle over a 108×108 box works out to a gradient line from
  (17.12, -9.88) to (90.88, 117.88) — it runs off the tile on both ends, which
  is what keeps the visible corners from banding.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="17.12"
                android:startY="-9.88"
                android:endX="90.88"
                android:endY="117.88">
                <item android:offset="0" android:color="#FFF0FBE8" />
                <item android:offset="1" android:color="#FFDDF3CC" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
