<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon silhouette. Android tints the whole drawable one colour from
  the wallpaper, so everything here is drawn black and nothing may rely on a
  second colour to be legible.

  That is what the even-odd path is for: the body, the eye and the pupil are
  three nested subpaths in one fill, so crossings alternate — body fills, the
  eye punches a hole through it, and the pupil fills back in. Drawn as separate
  paths the eye would simply vanish under the tint.

  The prototype's monochrome variant drops the crest feathers and the wing, and
  flattens the beak to one triangle. Kept that way: at 48dp under a tint, the
  detail turns to mud.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.6667"
        android:scaleY="0.6667">
        <group android:translateY="-3">

            <path
                android:fillColor="#FF000000"
                android:fillType="evenOdd"
                android:pathData="M42,32 L66,32 C74.8,32 82,39.2 82,48 L82,56 C82,64.8 74.8,72 66,72 L52,72 C48.5,78.5 42.5,82 36,82.5 C39,78.8 40.5,75.3 40.6,72 C32.3,71.3 26,64.2 26,56 L26,48 C26,39.2 33.2,32 42,32 Z M56.4,45.5 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0 Z M60.4,46.2 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0 Z" />

            <path
                android:fillColor="#FF000000"
                android:strokeColor="#FF000000"
                android:strokeWidth="2"
                android:strokeLineJoin="round"
                android:pathData="M73,44 L86.5,51 L73,59 Z" />
        </group>
    </group>
</vector>
